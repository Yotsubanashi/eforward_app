# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ─────────────────────────────────────────────────────────────
# Secrets & release signing — NEVER commit these
# ─────────────────────────────────────────────────────────────

# Environment variable files (keep the template .env.example tracked)
.env
.env.*
!.env.example

# Firebase config (contains project-specific keys; share out-of-band / via CI)
google-services.json
serviceAccountKey.json
**/GoogleService-Info.plist

# Android release signing (keystore + credentials)
**/key.properties
*.jks
*.keystore

# iOS signing
*.mobileprovision
*.p8
*.p12
*.certSigningRequest

# Build outputs
*.apk
*.aab
*.ipa

# Firebase hosting deploy cache
.firebase/
