<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Must be "production" for TestFlight / App Store builds
	     so push tokens register with the production APNs servers. Switch back to
	     "development" only for local debug push testing. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal Links: must live here (entitlements), NOT in Info.plist.
	     Host must match the reset link domain exactly (no "-api"). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:eforward.ardentnetworks.com.ph</string>
	</array>
</dict>
</plist>
