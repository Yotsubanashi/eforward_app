<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- APNs environment. Xcode flips this to "production" for release/App Store builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: must live here (entitlements), NOT in Info.plist.
	     Host must match the reset link domain exactly (no "-api"). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:eforward.ardentnetworks.com.ph</string>
	</array>
</dict>
</plist>
