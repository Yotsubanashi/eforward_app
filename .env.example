# ─────────────────────────────────────────────────────────────
# E-Forward environment template
# Copy this file to `.env` and fill in the values for your setup.
#   cp .env.example .env
# `.env` (and .env.ardent / .env.versa) are gitignored — never commit real values.
# ─────────────────────────────────────────────────────────────

# Primary (ARDENT) backend
API_BASE_URL=https://your-api-host/api
APP_BASE_URL=https://your-app-host
APP_BRAND=ARDENT

# Secondary (VERSATECH) backend — optional, used for multi-brand builds
API_VERSA_BASE_URL=https://your-versa-api-host/api
APP_VERSA_BASE_URL=https://your-versa-app-host
APP_VERSA_BRAND=VERSATECH
